# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# UPSTREAM_API_URL: Base URL for CR 41400 operational data server.
UPSTREAM_API_URL="https://elm-gristle-promotion.ngrok-free.dev"

# RPT_NETWORK_ROOT: UNC path or mounted directory for OCM network ZIP reports.
# Default: \\Fifgroup-report\app\ADHOC\qa\RPT_REG_OPERATION
RPT_NETWORK_ROOT=""

# GOOGLE_DRIVE_API_KEY: Server-side Google Cloud API Key with Google Drive API enabled
# to read public ("Anyone with the link") OCM Drive folder without user sign-in.
GOOGLE_DRIVE_API_KEY=""

# OCM_DRIVE_BRIDGE_URL: Optional Google Apps Script Web App URL (https://script.google.com/macros/s/.../exec)
# to read OCM files directly from Google Drive without API keys or user sign-in.
OCM_DRIVE_BRIDGE_URL=""
